<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Awoo.Connector.QQMusic</AssemblyName>
    <RootNamespace>UnifiedPlayerControlPoc</RootNamespace>
    <Version>22.61.5</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ConnectorRuntime.cs" Link="Shared\ConnectorRuntime.cs" />
    <!-- Keep QQ's restored 22.61.1 contract without changing other connectors. -->
    <Content Include="..\..\profiles\qqmusic\*.json"
             Link="profiles\qqmusic\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
