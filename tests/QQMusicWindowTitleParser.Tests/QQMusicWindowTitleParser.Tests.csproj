<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifier></RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableWindowsTargeting>false</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- These two sources use test-only Windows.Media.Control fakes. The
         regression executable never starts a real Windows media monitor. -->
    <Compile Include="..\..\src\QQMusic\QQMusicEventMonitor.cs"
             Link="QQMusicEventMonitor.cs" />
    <Compile Include="..\..\src\QQMusic\QQMusicMediaArtwork.cs"
             Link="QQMusicMediaArtwork.cs" />
    <Compile Include="..\..\src\QQMusic\QQMusicTimelineProbe.cs"
             Link="QQMusicTimelineProbe.cs" />
    <Compile Include="..\..\src\QQMusic\QQMusicAlbumArtwork.cs"
             Link="QQMusicAlbumArtwork.cs" />
    <Compile Include="..\..\src\QQMusic\QQMusicWindowTitleParser.cs"
             Link="QQMusicWindowTitleParser.cs" />
    <Compile Include="..\..\src\QQMusic\QQMusicTrackMatchPolicy.cs"
             Link="QQMusicTrackMatchPolicy.cs" />
    <Compile Include="..\..\src\QQMusic\QQMusicNativeController.cs"
             Link="QQMusicNativeController.cs" />
    <Compile Include="..\..\src\QQMusic\QQMusicAudioMuteScope.cs"
             Link="QQMusicAudioMuteScope.cs" />
    <Compile Include="..\..\src\QQMusic\QQMusicAudioSessionCapturePolicy.cs"
             Link="QQMusicAudioSessionCapturePolicy.cs" />
    <Compile Include="..\..\src\QQMusic\QQMusicPlaybackAnchorPolicy.cs"
             Link="QQMusicPlaybackAnchorPolicy.cs" />
    <Compile Include="..\..\src\Shared\PlayerContracts.cs"
             Link="PlayerContracts.cs" />
  </ItemGroup>
</Project>
